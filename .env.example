# 複製成 .env 後把每個密碼換成你自己的隨機值。.env 不進版控。
# 這些都只是本機模擬環境用的帳密；連接埠只綁 127.0.0.1。

# mosquitto（publisher 與 ingest 共用一組帳號）
MQTT_USERNAME=gemrobot
MQTT_PASSWORD=change-me
MQTT_PORT=1883

# TimescaleDB：擁有者帳號，只給 ingest 寫入用
POSTGRES_DB=gemrobot
POSTGRES_USER=gem_owner
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# 唯讀角色（只有 SELECT）：MCP server 與 Grafana 用。初始化 SQL 會建立它。
READONLY_USER=gem_readonly
READONLY_PASSWORD=change-me

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
